@@ -19,6 +19,13 @@ from services import prompts
 
 logger = logging.getLogger(__name__)
 
+# MuseBot never registers tools/functions with Gemini, so automatic function calling
+# (AFC) has nothing to do here. Disabling it explicitly silences google-genai's
+# "Direct use of AFC ... is not recommended" warning -- it's not an error, just noise.
+_NO_AFC_CONFIG = types.GenerateContentConfig(
+    automatic_function_calling=types.AutomaticFunctionCallingConfig(disable=True)
+)
+
 _client = genai.Client(api_key=GEMINI_API_KEY)
 
 # Google has been retiring Gemini Flash model IDs faster than their own published
@@ -65,6 +72,15 @@ def _is_rate_limited(e: Exception) -> bool:
     return "RESOURCE_EXHAUSTED" in msg or "429" in msg
 
 
+def _is_transiently_unavailable(e: Exception) -> bool:
+    # 503 "This model is currently experiencing high demand... try again later" --
+    # Google's own wording confirms this is temporary, not a real outage of the
+    # model. Treat it like a rate limit: try the next candidate now, but don't
+    # permanently blacklist the model since it should recover shortly.
+    msg = str(e)
+    return "UNAVAILABLE" in msg or "503" in msg
+
+
 def _candidates_for(kind: str) -> list:
     with _state_lock:
         active = _active_text_model if kind == "text" else _active_vision_model
