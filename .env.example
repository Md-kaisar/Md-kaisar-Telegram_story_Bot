# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API key (free tier) from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides. Leave unset to use the code's default (gemini-3.5-flash), which
# ai_service.py will also automatically fall back away from if Google retires it later
# (see the model-fallback chain in services/ai_service.py / README troubleshooting).
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash
DB_PATH=./data/musebot.db
# Optional: your own numeric Telegram user/chat ID. If set, MuseBot DMs you whenever
# a new person starts the bot. Get your ID by messaging @userinfobot on Telegram.
ADMIN_CHAT_ID=

DAILY_GENERATION_LIMIT=40
